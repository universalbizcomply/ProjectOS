    "push",
    "phase-closure",
    "secrets-handling",
    "production-deploy",
    "production-db-mutation",
    "real-email-sms-whatsapp",
    "payment-or-live-charge"
  ],
  "secretsPolicy": {
    "allowSecretsInRepo": false,
    "redactionRequired": true,
    "notes": "No raw secret values are stored in plan memory, current state, sessions, reports or prompts. Providers are referenced by name only. Redaction is required for any sensitive value."
  },
  "execution": {
    "checks": [
      {
        "id": "core-tests",
        "kind": "test",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": [
          "C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js",
          "--prefix",
          "projectos/core",
          "test"
        ]
      },
      {
        "id": "agent-tests",
        "kind": "test",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": [
          "C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js",
          "--prefix",
          "projectos/agent",
          "test"
        ]
      },
      {
        "id": "agent-typecheck",
        "kind": "typecheck",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": [
          "C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js",
          "--prefix",
          "projectos/agent",
          "run",
          "typecheck:all"
        ]
      }
    ],
    "defaultWorkerId": "claude-local",
    "workers": [
      {
        "workerId": "claude-local",
        "kind": "claude-code-cli",
        "command": "C:/Users/murad/.local/bin/claude.exe",
        "args": [
          "--allowedTools",
          "Write(.projectops/execution/*.findings.json),Edit(.projectops/execution/*.findings.json),Write(.projectops/execution/*.effects.json),Edit(.projectops/execution/*.effects.json)"
        ],
        "notes": "The owner's local Claude Code CLI. Absolute by requirement: a bare name would resolve against the governed checkout before PATH. No credential is passed and no Anthropic API is called — use-anthropic-api remains a forbidden action. The allowlist grants exactly the two records the WORKER owns: its findings and its effects attestation. It deliberately does NOT cover *.brief.json, *.session.json or *.evidence.json — those are ProjectOS's, and a worker able to rewrite the brief it was judged against, or the evidence collected about it, could launder its own run. An earlier grant of .projectops/execution/** was too broad and was narrowed here; `workers.ts` refuses any grant that is not exactly one of these four patterns, so a future config cannot widen it silently."
      }
    ]
  },
  "validators": [
    "projectos/validators/validate-all.cjs"
  ],
  "evidenceRequirements": [
    "evidence-pack",
    "validator-results",
    "scope-confirmation",
    "reports-index:knowledge/ProjectOS Reports Index.md",
    "phase-reports:knowledge/reports/"
  ],
  "installStatus": "installed"
}
