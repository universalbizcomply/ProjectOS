{
  "projectId": "projectos",
  "projectName": "ProjectOS",
  "projectType": "delivery-os",
  "owner": "Murad",
  "repo": "universalbizcomply/ProjectOS",
  "localPath": "C:/dev/ProjectOS",
  "environments": {},
  "protectedBranches": [
    "main",
    "projectos-v2-core"
  ],
  "productionFreeze": true,
  "planMemory": {
    "planPath": "projectos/state/projectos-recovery.plan.json",
    "currentStatePath": "projectos/state/projectos-recovery.current-state.json"
  },
  "planSources": [
    "docs/operational-recovery-plan.md",
    "projectos/state/projectos-v3.plan.json",
    "projectos/state/projectos-v3.current-state.json"
  ],
  "allowedActions": [
    "inspect-repository",
    "create-local-files",
    "run-local-validation",
    "produce-evidence-report"
  ],
  "forbiddenActions": [
    "production-deploy",
    "production-db-mutation",
    "real-email-sms-whatsapp",
    "payment-or-live-charge",
    "force-push",
    "use-openai-api",
    "use-anthropic-api",
    "provider-credential-access",
    "store-real-secret",
    "modify-projectos-v2-core",
    "modify-v2-closure-records",
    "modify-polygo"
  ],
  "approvalGates": [
    "commit",
    "push",
    "phase-closure",
    "secrets-handling",
    "production-deploy",
    "production-db-mutation",
    "real-email-sms-whatsapp",
    "payment-or-live-charge"
  ],
  "secretsPolicy": {
    "allowSecretsInRepo": false,
    "redactionRequired": true,
    "notes": "No raw secret values are stored in plan memory, current state, sessions, reports or prompts. Providers are referenced by name only. Redaction is required for any sensitive value."
  },
  "execution": {
    "checks": [
      {
        "id": "core-tests",
        "kind": "test",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": ["C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js", "--prefix", "projectos/core", "test"]
      },
      {
        "id": "agent-tests",
        "kind": "test",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": ["C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js", "--prefix", "projectos/agent", "test"]
      },
      {
        "id": "agent-typecheck",
        "kind": "typecheck",
        "command": "C:/Program Files/nodejs/node.exe",
        "args": ["C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js", "--prefix", "projectos/agent", "run", "typecheck:all"]
      }
    ],
    "defaultWorkerId": "claude-local",
    "workers": [
      {
        "workerId": "claude-local",
        "kind": "claude-code-cli",
        "command": "C:/Users/murad/.local/bin/claude.exe",
        "args": ["--allowedTools", "Write(.projectops/execution/**),Edit(.projectops/execution/**)"],
        "notes": "The owner's local Claude Code CLI. Absolute by requirement: a bare name would resolve against the governed checkout before PATH. No credential is passed and no Anthropic API is called — use-anthropic-api remains a forbidden action. The allowlist is the narrowest grant that lets the loop work at all: the first live run ended with the worker asking a human for permission to write the very findings and effects records the loop then refuses to proceed without, and a non-interactive worker has nobody to ask. It covers ONLY .projectops/execution/ — the run's own records. It grants nothing over source, and every other write still requires a decision the worker cannot make alone."
      }
    ]
  },
  "validators": [
    "projectos/validators/validate-all.cjs"
  ],
  "evidenceRequirements": [
    "evidence-pack",
    "validator-results",
    "scope-confirmation",
    "reports-index:knowledge/ProjectOS Reports Index.md",
    "phase-reports:knowledge/reports/"
  ],
  "installStatus": "installed"
}
