{
  "projectId": "projectos",
  "projectName": "ProjectOS",
  "projectType": "delivery-os",
  "owner": "Murad",
  "repo": "universalbizcomply/ProjectOS",
  "localPath": "C:/dev/ProjectOS",
  "environments": {},
  "protectedBranches": [
    "main",
    "projectos-v2-core"
  ],
  "productionFreeze": true,
  "planMemory": {
    "planPath": "projectos/state/projectos-recovery.plan.json",
    "currentStatePath": "projectos/state/projectos-recovery.current-state.json"
  },
  "planSources": [
    "docs/operational-recovery-plan.md",
    "projectos/state/projectos-v3.plan.json",
    "projectos/state/projectos-v3.current-state.json"
  ],
  "allowedActions": [
    "inspect-repository",
    "create-local-files",
    "run-local-validation",
    "produce-evidence-report"
  ],
  "forbiddenActions": [
    "production-deploy",
    "production-db-mutation",
    "real-email-sms-whatsapp",
    "payment-or-live-charge",
    "force-push",
    "use-openai-api",
    "use-anthropic-api",
    "provider-credential-access",
    "store-real-secret",
    "modify-projectos-v2-core",
    "modify-v2-closure-records",
    "modify-polygo"
  ],
  "approvalGates": [
    "commit",
    "push",
    "phase-closure",
    "secrets-handling",
    "production-deploy",
    "production-db-mutation",
    "real-email-sms-whatsapp",
    "payment-or-live-charge"
  ],
  "secretsPolicy": {
    "allowSecretsInRepo": false,
    "redactionRequired": true,
    "notes": "No raw secret values are stored in plan memory, current state, sessions, reports or prompts. Providers are referenced by name only. Redaction is required for any sensitive value."
  },
  "validators": [
    "projectos/validators/validate-all.cjs"
  ],
  "evidenceRequirements": [
    "evidence-pack",
    "validator-results",
    "scope-confirmation",
    "reports-index:knowledge/ProjectOS Reports Index.md",
    "phase-reports:knowledge/reports/"
  ],
  "installStatus": "installed"
}
