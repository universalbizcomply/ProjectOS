{
  "name": "@projectos/core",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectOS Core Engine — pure TypeScript kernel (phase, task, approval, risk, permissions, events, config, plugins, workflow).",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "license": "UNLICENSED"
}
