{
  "name": "@projectos/control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectOS Control Center — Mission Control desktop UI (Vite + React) over the core, wrapped by Tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:sidecar": "tsc -p tsconfig.node.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@projectos/bridge-daemon": "file:../bridge/daemon",
    "@projectos/core": "file:../core",
    "@supabase/supabase-js": "^2.47.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
