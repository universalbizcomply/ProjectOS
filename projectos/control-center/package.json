{
  "name": "@projectos/control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectOS Control Center — Mission Control desktop UI (Vite + React) over the core, wrapped by Tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:sidecar": "tsc -p tsconfig.node.json",
    "build:daemon-bundle": "npm run build:sidecar && node packaging/build-daemon-bundle.mjs",
    "verify:packaged-daemon": "node packaging/verify-packaged-daemon.mjs",
    "release:payload": "node packaging/build-release-payload.mjs",
    "release:prepare": "npm run build && npm run release:payload",
    "pretest": "npm --prefix ../agent run build",
  "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:desktop": "node test-desktop/smoke.mjs",
    "build:fixture": "vite build --config test-desktop/fixture/vite.config.ts",
    "test:desktop:mission-control": "node test-desktop/mission-control-smoke.mjs",
    "validate:fixture-isolation": "node test-desktop/validate-fixture-isolation.cjs",
    "tauri": "tauri",
    "test:desktop:e2e": "wdio run wdio.conf.ts",
    "build:desktop:e2e": "node test-desktop/build-e2e.mjs"
  },
  "dependencies": {
    "@projectos/agent": "file:../agent",
    "@projectos/bridge-daemon": "file:../bridge/daemon",
    "@projectos/core": "file:../core",
    "@supabase/supabase-js": "^2.47.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.21.5",
    "@vitest/coverage-v8": "^2.1.8",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "webdriverio": "^9.30.1"
  }
}
