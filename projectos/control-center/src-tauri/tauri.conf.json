{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectOS Control Center",
  "version": "0.1.0",
  "identifier": "com.universalbizcomply.projectos.control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectOS · Control Center",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
