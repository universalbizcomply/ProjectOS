{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectOS Control Center",
  "version": "0.1.0",
  "identifier": "com.universalbizcomply.projectos.control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run release:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectOS \u00b7 Control Center",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": {
      "../dist-payload": "runtime-payload"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "generated/installation-record.wxs"
        ],
        "componentGroupRefs": [
          "ProjectOSInstallationRecord"
        ],
        "template": "../packaging/wix/main.wxs"
      }
    }
  }
}
