{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/tenant-registry.schema.json",
  "title": "ProjectOS Tenant Registry",
  "description": "projectos/security/tenant-registry.json. Binds projectId, repository and governedRoot to one tenant and one domain. Installation record, read from committed bytes. Uniqueness across entries and roots nested in one another cannot be stated in JSON Schema; parseTenantRegistry in projectos/core/src/tenant.ts enforces them and validates the whole file before any match.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "note",
    "authority",
    "authorisedBy",
    "provenance",
    "trustBasis",
    "tenants",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policy": {
      "const": "tenant-registry"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "authorisedBy": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "trustBasis": {
      "type": "string",
      "minLength": 1
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "name"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,56}$",
            "description": "At most 57 characters, so tenant.<tenantId> fits a 64-character credential reference segment."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "repository",
          "governedRoot",
          "tenant",
          "domain"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "not": {
              "pattern": "^[Tt][Ee][Nn][Aa][Nn][Tt]\\."
            },
            "description": "A credential reference segment. 'tenant.' is reserved, case-insensitively, for tenant-class credentials."
          },
          "repository": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+|127\\.0\\.0\\.1:[0-9]{1,5})/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
            "not": {
              "pattern": "\\.[Gg][Ii][Tt]$"
            },
            "description": "host/owner/name, as parseRemoteUrl canonicalises it. ASCII, exactly three segments, no .git, no trailing slash. Only the loopback host may carry a port. The same rule as REPOSITORY in tenant.ts, pinned by TC-8."
          },
          "governedRoot": {
            "type": "string",
            "pattern": "^[A-Za-z]:(?:/[A-Za-z0-9_][A-Za-z0-9._ -]*)+$",
            "not": {
              "pattern": "[. ](/|$)"
            },
            "description": "Absolute, forward slashes, ASCII, one character class per segment, no segment Windows would trim. No wildcards, no second colon, no tilde, no percent. The same rule as GOVERNED_ROOT in tenant.ts, pinned by TC-8."
          },
          "tenant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,56}$",
            "description": "A tenantId declared in tenants."
          },
          "domain": {
            "enum": [
              "develop",
              "business",
              "personal",
              "phone"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
