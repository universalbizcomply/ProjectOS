{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/proof-request.schema.json",
  "title": "ProjectOS Proof Request",
  "description": "Input shape for a future controlled proof. Planning/reporting only; never executes a proof. Production targets and secrets are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project", "phase", "requestedBy", "targetEnvironment", "targetUrl", "branch", "commit",
    "scope", "proofObjective", "proofType", "proofDataRequired", "testDataClassification",
    "allowedDataActions", "forbiddenDataActions", "databaseTouched", "databaseMutationPlanned",
    "externalSendsPlanned", "paymentActionPlanned", "secretsRequired", "externalApisRequired",
    "validatorsRequired", "validatorsRun", "requiredReviews", "rollbackPlan", "cleanupRequired",
    "cleanupPlanPath", "proofEvidencePath", "approvalStatus", "ownerApprovalReference",
    "decisionNeeded", "reportPath"
  ],
  "properties": {
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "requestedBy": { "type": "string" },
    "targetEnvironment": { "type": "string", "enum": ["staging", "preview", "development", "test", "local"], "description": "Must not be production." },
    "targetUrl": { "type": "string" },
    "branch": { "type": "string" },
    "commit": { "type": "string" },
    "scope": { "type": "string" },
    "proofObjective": { "type": "string" },
    "proofType": { "type": "string", "description": "e.g. no-send-proof, read-only-smoke, lifecycle-sandbox." },
    "proofDataRequired": { "type": "boolean" },
    "testDataClassification": { "type": "string", "enum": ["synthetic", "masked", "anonymised", "none"], "description": "No real PII/customer data." },
    "allowedDataActions": { "type": "array", "items": { "type": "string" } },
    "forbiddenDataActions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "databaseTouched": { "type": "boolean" },
    "databaseMutationPlanned": { "type": "boolean" },
    "externalSendsPlanned": { "type": "boolean" },
    "paymentActionPlanned": { "type": "boolean" },
    "secretsRequired": { "type": "boolean", "description": "Must be false." },
    "externalApisRequired": { "type": "boolean" },
    "validatorsRequired": { "type": "array", "items": { "type": "string" } },
    "validatorsRun": { "type": "array", "items": { "type": "string" } },
    "requiredReviews": { "type": "array", "items": { "type": "string" } },
    "rollbackPlan": { "type": "string" },
    "cleanupRequired": { "type": "boolean" },
    "cleanupPlanPath": { "type": "string" },
    "proofEvidencePath": { "type": "string" },
    "approvalStatus": { "type": "string", "enum": ["DRAFT", "READY-FOR-REVIEW", "BLOCKED", "APPROVED-FOR-STAGING-PROOF", "PROOF-RUN-RECORDED", "CLEANUP-REQUIRED", "CLEANUP-PLANNED", "CLEANUP-VERIFIED", "REJECTED"], "description": "Explicit only; never inferred. APPROVED-FOR-STAGING-PROOF only if owner/advisor supplied it." },
    "ownerApprovalReference": { "type": "string" },
    "decisionNeeded": { "type": "string" },
    "reportPath": { "type": "string" }
  }
}