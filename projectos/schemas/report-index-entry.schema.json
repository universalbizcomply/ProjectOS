{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/report-index-entry.schema.json",
  "title": "ProjectOS Report Index Entry",
  "description": "Metadata for one row in ProjectOS Reports Index.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "project", "phase", "status", "commit", "reportFile", "notes"],
  "properties": {
    "date": { "type": "string", "description": "YYYY-MM-DD." },
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "status": { "type": "string", "enum": ["AWAITING-REVIEW", "AWAITING-CLOSURE", "BLOCKED", "DO-NOT-CLOSE", "CLOSED"] },
    "commit": { "type": "string" },
    "reportFile": { "type": "string" },
    "notes": { "type": "string" }
  }
}