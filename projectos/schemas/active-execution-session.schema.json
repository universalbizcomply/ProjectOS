{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/active-execution-session.schema.json",
  "title": "ProjectOS Active Execution Session",
  "description": "Transient state of a single execution run (source-of-truth hierarchy level 4). Must explicitly prove no raw secret is stored and no forbidden side-effect occurred. Created in PROJECTOS-V3-MASTER-PLAN-MEMORY1A.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sessionId", "projectId", "planId", "planVersion", "phaseId",
    "executionMode", "autonomyLevel", "repositoryPath", "branch", "startingHead", "currentHead",
    "filesInspected", "filesChanged", "commandsRun", "validatorResults", "testResults",
    "browserResults", "ECCResults", "securityResults", "codeReviewResults", "databaseReviewResults",
    "currentAction", "blockedReason", "nextSafeAction", "decisionRequired",
    "productionTouched", "deploymentOccurred", "databaseMutationOccurred", "externalSendOccurred",
    "paymentOccurred", "secretCapabilityUsed", "rawSecretStored", "createdAt", "updatedAt", "sessionStatus"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "sessionId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "phaseId": { "type": "string", "minLength": 1 },
    "executionMode": { "type": "string", "enum": ["read-only", "local-safe", "gated-execution"] },
    "autonomyLevel": { "type": "string", "enum": ["read-only", "local-safe", "gated-execution"] },
    "repositoryPath": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "startingHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "currentHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "filesInspected": { "type": "array", "items": { "type": "string" } },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "commandsRun": { "type": "array", "items": { "type": "string" } },
    "validatorResults": { "type": "array", "items": { "type": "string" } },
    "testResults": { "type": "array", "items": { "type": "string" } },
    "browserResults": { "type": "array", "items": { "type": "string" } },
    "ECCResults": { "type": "array", "items": { "type": "string" } },
    "securityResults": { "type": "array", "items": { "type": "string" } },
    "codeReviewResults": { "type": "array", "items": { "type": "string" } },
    "databaseReviewResults": { "type": "array", "items": { "type": "string" } },
    "currentAction": { "type": "string" },
    "blockedReason": { "type": ["string", "null"] },
    "nextSafeAction": { "type": "string" },
    "decisionRequired": { "type": ["string", "null"] },
    "productionTouched": { "type": "boolean", "const": false },
    "deploymentOccurred": { "type": "boolean", "const": false },
    "databaseMutationOccurred": { "type": "boolean", "const": false },
    "externalSendOccurred": { "type": "boolean", "const": false },
    "paymentOccurred": { "type": "boolean", "const": false },
    "secretCapabilityUsed": { "type": "boolean", "const": false },
    "rawSecretStored": { "type": "boolean", "const": false },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "sessionStatus": { "type": "string", "enum": ["active", "blocked", "awaiting-decision", "complete", "aborted"] }
  }
}
