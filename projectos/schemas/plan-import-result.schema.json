{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/plan-import-result.schema.json",
  "title": "ProjectOS Plan-Import Result",
  "description": "Deterministic result of discovering, classifying, reconciling and drafting a project plan from existing sources. Embeds duplicate groups, conflict records, a structured plan draft with field-level provenance, and a calculated plan status. Never grants PLAN READY. Created in PROJECTOS-V3-PLAN-DISCOVERY-IMPORT1A.",
  "type": "object",
  "required": ["schemaVersion", "projectContext", "status", "duplicates", "conflicts", "draft", "ownerApprovalRequired", "planReadyGranted"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "projectContext": { "type": "string", "description": "Which project this import belongs to. Never conflated across projects." },
    "status": { "type": "string", "enum": ["NO PLAN", "PLAN DISCOVERED", "PLAN CONFLICT", "PLAN DRAFTED", "AWAITING OWNER APPROVAL", "PLAN READY", "PLAN STALE", "PLAN BLOCKED"] },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["groupId", "kind", "members"],
        "properties": {
          "groupId": { "type": "string" },
          "kind": { "type": "string", "enum": ["EXACT", "NORMALIZED", "STRUCTURAL"] },
          "members": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflictId", "field", "sourceA", "sourceB", "valueA", "valueB", "severity", "autoResolvable", "ownerDecisionRequired", "planStatusEffect"],
        "properties": {
          "conflictId": { "type": "string" },
          "field": { "type": "string" },
          "kind": { "type": "string" },
          "sourceA": { "type": "string" },
          "sourceB": { "type": "string" },
          "valueA": { "type": "string" },
          "valueB": { "type": "string" },
          "authorityA": { "type": "string" },
          "authorityB": { "type": "string" },
          "severity": { "type": "string", "enum": ["material", "minor"] },
          "autoResolvable": { "type": "boolean" },
          "selectedResolution": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "ownerDecisionRequired": { "type": "boolean" },
          "planStatusEffect": { "type": "string" }
        }
      }
    },
    "draft": {
      "type": "object",
      "required": ["schemaVersion", "authoritativeSource", "sourceInventory", "provenance", "phaseCandidates", "unresolvedUnknowns", "ownerDecisionsRequired", "importConfidence"],
      "properties": {
        "authoritativeSource": { "type": ["string", "null"] },
        "sourceInventory": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "value", "sourcePath", "sourceChecksum", "sourceAuthority", "extractionMethod", "confidence", "manualReviewRequired"],
            "properties": {
              "field": { "type": "string" },
              "value": {},
              "sourcePath": { "type": ["string", "null"] },
              "sourceChecksum": { "type": ["string", "null"] },
              "locator": { "type": ["string", "null"] },
              "sourceAuthority": { "type": ["string", "null"] },
              "extractionMethod": { "type": "string" },
              "confidence": { "type": "string" },
              "competingSources": { "type": "array" },
              "conflictRef": { "type": ["string", "null"] },
              "manualReviewRequired": { "type": "boolean" }
            }
          }
        },
        "phaseCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phaseId", "sourceReferences", "confidence"],
            "properties": {
              "phaseId": { "type": "string" },
              "sourceReferences": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "string" }
            }
          }
        },
        "unresolvedUnknowns": { "type": "array", "items": { "type": "string" } },
        "ownerDecisionsRequired": { "type": "array", "items": { "type": "string" } },
        "importConfidence": { "type": "string" }
      }
    },
    "ownerApprovalRequired": { "type": "boolean", "const": true },
    "planReadyGranted": { "type": "boolean", "const": false, "description": "This phase never grants PLAN READY; that remains the Phase 1 evidence gate + owner approval." }
  }
}
