{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/watchdog-sentinel-registry.schema.json",
  "title": "ProjectOS Watchdog Sentinel Registry",
  "description": "Generated by projectos/scripts/watchdog-sentinel-registry.cjs from ProjectOS-controlled config and committed into the separate sentinel repository through a reviewed change. Read by the sentinel at runtime; the sentinel never contacts ProjectOS. Safe data only: no credentials, no addresses, no mutation authority. Stamped with the ProjectOS source commit and a content hash; drift fails validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "generated_by", "source_commit", "entries", "content_sha256"],
  "properties": {
    "registry_version": { "const": 1 },
    "generated_by": { "type": "string" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "environment", "public_url", "health_path", "expected_service", "expected_release", "timeout_ms", "check_classes"],
        "properties": {
          "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
          "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
          "public_url": { "type": "string", "pattern": "^https://" },
          "health_path": { "type": ["string", "null"] },
          "expected_service": { "type": ["string", "null"] },
          "expected_release": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "expected_environment": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
          "expected_watchdog": { "type": ["string", "null"], "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$" },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 10000 },
          "check_classes": { "type": "array", "minItems": 1, "items": { "enum": ["reachability", "https", "health", "release_identity"] } }
        }
      }
    }
  }
}
