{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/staging-deploy-request.schema.json",
  "title": "ProjectOS Staging Deploy Request",
  "description": "Input shape for a future STAGING deploy request. This phase generates plans/reports only; it never deploys. Production handling is a separate, owner-approved future phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project", "phase", "requestedBy", "targetEnvironment", "targetUrl", "hostingProvider",
    "branch", "commit", "filesChanged", "scope", "validatorsRequired", "validatorsRun",
    "requiredReviews", "reviewStatus", "forbiddenActionsChecked", "productionTouched",
    "databaseTouched", "databaseMutationPlanned", "externalSendsPlanned", "paymentActionPlanned",
    "secretsAccessed", "externalApisRequired", "rollbackPlan", "stagingProofPlan",
    "approvalStatus", "ownerApprovalReference", "decisionNeeded", "reportPath"
  ],
  "properties": {
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "requestedBy": { "type": "string" },
    "targetEnvironment": { "type": "string", "enum": ["staging"], "description": "Must be staging in this phase." },
    "targetUrl": { "type": "string" },
    "hostingProvider": { "type": "string", "description": "e.g. vercel, netlify, other." },
    "branch": { "type": "string" },
    "commit": { "type": "string" },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "string" },
    "validatorsRequired": { "type": "array", "items": { "type": "string" } },
    "validatorsRun": { "type": "array", "items": { "type": "string" } },
    "requiredReviews": { "type": "array", "items": { "type": "string" } },
    "reviewStatus": { "type": "string" },
    "forbiddenActionsChecked": { "type": "array", "items": { "type": "string" } },
    "productionTouched": { "type": "boolean", "description": "Must be false." },
    "databaseTouched": { "type": "boolean" },
    "databaseMutationPlanned": { "type": "boolean" },
    "externalSendsPlanned": { "type": "boolean" },
    "paymentActionPlanned": { "type": "boolean" },
    "secretsAccessed": { "type": "boolean", "description": "Must be false." },
    "externalApisRequired": { "type": "boolean" },
    "rollbackPlan": { "type": "string" },
    "stagingProofPlan": { "type": "string" },
    "approvalStatus": { "type": "string", "enum": ["DRAFT", "READY-FOR-REVIEW", "BLOCKED", "APPROVED-FOR-STAGING-DEPLOY", "DEPLOYED-TO-STAGING", "REJECTED"], "description": "Explicit only; never inferred. APPROVED-FOR-STAGING-DEPLOY only if owner/advisor supplied it." },
    "ownerApprovalReference": { "type": "string", "description": "Reference to the owner/advisor decision, or 'none'." },
    "decisionNeeded": { "type": "string" },
    "reportPath": { "type": "string" }
  }
}