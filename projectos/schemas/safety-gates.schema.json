{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/safety-gates.schema.json",
  "title": "ProjectOS Safety Gates",
  "description": "Canonical set of safety gates. Every gate is owner-gated or prohibited unless explicitly overridden by the owner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productionDeployGate", "productionDbMutationGate", "realMessagingGate",
    "paymentGate", "secretsHandlingGate", "forcePushProhibition",
    "externalServiceGate", "closureAuthorityGate"
  ],
  "properties": {
    "productionDeployGate": { "$ref": "#/definitions/gate" },
    "productionDbMutationGate": { "$ref": "#/definitions/gate" },
    "realMessagingGate": { "$ref": "#/definitions/gate", "description": "Real email / SMS / WhatsApp send." },
    "paymentGate": { "$ref": "#/definitions/gate", "description": "Payment / live charge / refund." },
    "secretsHandlingGate": { "$ref": "#/definitions/gate" },
    "forcePushProhibition": { "$ref": "#/definitions/gate" },
    "externalServiceGate": { "$ref": "#/definitions/gate", "description": "Any external service / API call." },
    "closureAuthorityGate": { "$ref": "#/definitions/gate", "description": "Only Murad/ChatGPT may close a phase." }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "required": ["status", "requiresOwnerApproval", "description"],
      "properties": {
        "status": { "type": "string", "enum": ["gated", "prohibited"] },
        "requiresOwnerApproval": { "type": "boolean" },
        "description": { "type": "string" }
      }
    }
  }
}