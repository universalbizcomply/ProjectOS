{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/bridge/evidence-pack.schema.json",
  "title": "ProjectOS Bridge Evidence Pack",
  "description": "Packaged evidence for a phase, produced by Claude/Agent. Redacted — no secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project", "phase", "status", "created_at", "created_by", "worker",
    "source", "version", "branch", "filesChanged", "validators", "confirmations",
    "risks", "decision_required"
  ],
  "properties": {
    "id": { "type": "string", "description": "evid_<ulid>" },
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "ready"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "enum": ["implementer", "agent"] },
    "worker": { "type": "string" },
    "source": { "type": "string" },
    "version": { "type": "string" },
    "checksum": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string" },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "not-available"] }
        }
      }
    },
    "confirmations": {
      "type": "object",
      "description": "explicit yes/no safety confirmations",
      "properties": {
        "secretsUsed": { "type": "boolean" },
        "productionTouched": { "type": "boolean" },
        "externalSends": { "type": "boolean" },
        "payments": { "type": "boolean" },
        "forcePush": { "type": "boolean" }
      }
    },
    "assets": { "type": "array", "items": { "type": "string" }, "description": "relative paths to screenshots/logs (no secrets)" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "carryForward": { "type": "array", "items": { "type": "string" } },
    "related_files": { "type": "array", "items": { "type": "string" } },
    "decision_required": { "type": "boolean" }
  }
}
