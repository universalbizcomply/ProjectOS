{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/bridge/report.schema.json",
  "title": "ProjectOS Bridge Report",
  "description": "Implementation report written by Claude Code after a phase. No secrets — placeholders only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project", "phase", "status", "created_at", "created_by", "worker",
    "source", "version", "branch", "filesChanged", "summary", "validators",
    "secretsUsed", "gatedActionsPerformed", "productionTouched", "externalSends",
    "risks", "carryForward", "decision_required"
  ],
  "properties": {
    "id": { "type": "string", "description": "report_<ulid>" },
    "project": { "type": "string" },
    "phase": { "type": "string" },
    "status": { "type": "string", "enum": ["implemented-locally", "awaiting-review", "changes-requested", "closed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "enum": ["implementer"] },
    "worker": { "type": "string", "description": "e.g. claude-code" },
    "source": { "type": "string" },
    "version": { "type": "string" },
    "checksum": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string", "description": "short sha or 'not committed'" },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "not-available"] },
          "detail": { "type": "string" }
        }
      }
    },
    "secretsUsed": { "type": "boolean" },
    "gatedActionsPerformed": { "type": "array", "items": { "type": "string" } },
    "productionTouched": { "type": "boolean" },
    "externalSends": { "type": "boolean" },
    "securityReview": { "type": "string" },
    "codeReview": { "type": "string" },
    "databaseReview": { "type": "string" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "carryForward": { "type": "array", "items": { "type": "string" } },
    "related_files": { "type": "array", "items": { "type": "string" } },
    "decision_required": { "type": "boolean" }
  }
}
