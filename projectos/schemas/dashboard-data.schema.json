{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/dashboard-data.schema.json",
  "title": "ProjectOS Dashboard Data",
  "description": "Generated dashboard JSON. sourceMode must be local-static. No external API / live inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dashboard", "generatedAt", "sourceMode", "projects", "phases", "risks",
    "carryForward", "blockers", "summary", "sourceLimitations", "decisionNeeded"
  ],
  "properties": {
    "dashboard": { "type": "string" },
    "generatedAt": { "type": "string" },
    "sourceMode": { "type": "string", "enum": ["local-static"] },
    "externalApisUsed": { "type": "boolean" },
    "liveInspectionUsed": { "type": "boolean" },
    "productReposScanned": { "type": "boolean" },
    "secretsUsed": { "type": "boolean" },
    "projects": { "type": "array", "items": { "type": "object" } },
    "phases": { "type": "array", "items": { "type": "object" } },
    "risks": { "type": "array", "items": { "type": "object" } },
    "carryForward": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "object" },
    "sourceLimitations": { "type": "string" },
    "decisionNeeded": { "type": "string" }
  }
}