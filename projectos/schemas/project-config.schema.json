{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projectos/schemas/project-config.schema.json",
  "title": "ProjectOS Project Config",
  "description": "Per-project configuration for a ProjectOS-governed project. Universal shape; project-specific values. Extended in PROJECTOPS-ECC-REVIEW-WIRING1A with controlled review-agent wiring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId", "projectName", "projectType", "owner", "repo", "localPath",
    "environments", "protectedBranches", "productionFreeze", "allowedActions",
    "forbiddenActions", "approvalGates", "secretsPolicy", "validators",
    "evidenceRequirements", "installStatus"
  ],
  "properties": {
    "projectId": { "type": "string", "description": "Stable slug, e.g. polygo." },
    "projectName": { "type": "string" },
    "projectType": { "type": "string", "description": "e.g. saas, booking-platform, ops-tool, ecommerce, erp." },
    "owner": { "type": "string", "description": "Owner / final approver." },
    "repo": { "type": "string", "description": "Canonical repo (owner/name) or 'none'." },
    "localPath": { "type": "string" },
    "environments": {
      "type": "object",
      "description": "Named environments and their public identifiers (no secrets).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "supabaseRef": { "type": "string" },
          "host": { "type": "string" }
        }
      }
    },
    "protectedBranches": { "type": "array", "items": { "type": "string" } },
    "productionFreeze": { "type": "boolean" },
    "allowedActions": { "type": "array", "items": { "type": "string" } },
    "forbiddenActions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "approvalGates": {
      "type": "array",
      "description": "Actions requiring explicit owner approval.",
      "items": { "type": "string" },
      "minItems": 1
    },
    "secretsPolicy": {
      "type": "object",
      "required": ["allowSecretsInRepo", "redactionRequired"],
      "properties": {
        "allowSecretsInRepo": { "type": "boolean" },
        "redactionRequired": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "validators": { "type": "array", "items": { "type": "string" } },
    "evidenceRequirements": { "type": "array", "items": { "type": "string" } },
    "installStatus": { "type": "string", "enum": ["not-installed", "planned", "installed", "deferred"] },

    "reviewAgents": {
      "type": "array",
      "description": "Named review providers (e.g. ECC agents). Configuration only — ProjectOS does not auto-run them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "provider", "category", "displayName", "allowedModes",
          "externalToolsAllowed", "requiresOwnerApprovalForExternalTools",
          "evidencePackSection", "enabledByDefault"
        ],
        "properties": {
          "id": { "type": "string", "description": "e.g. code-reviewer, security-reviewer." },
          "provider": { "type": "string", "description": "e.g. ecc, manual, none." },
          "category": {
            "type": "string",
            "enum": [
              "code-review", "security-review", "database-review",
              "build-lint-typecheck-review", "test-review",
              "quality-gate-review", "planner-review", "silent-failure-review"
            ]
          },
          "displayName": { "type": "string" },
          "allowedModes": {
            "type": "array",
            "description": "Permitted modes; default local-read-only. External/MCP modes require owner approval in a later phase.",
            "items": { "type": "string", "enum": ["local-read-only", "external-tools", "mcp"] }
          },
          "externalToolsAllowed": { "type": "boolean", "description": "Must default to false." },
          "requiresOwnerApprovalForExternalTools": { "type": "boolean" },
          "evidencePackSection": { "type": "string" },
          "enabledByDefault": { "type": "boolean" }
        }
      }
    },
    "reviewAgentGroups": {
      "type": "object",
      "description": "Named groups of reviewAgent ids, e.g. 'standard': [code-reviewer, security-reviewer].",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "defaultRequiredReviews": {
      "type": "array",
      "description": "Review categories required by default for this project's phases.",
      "items": { "type": "string" }
    },
    "externalToolsPolicy": {
      "type": "object",
      "required": ["default", "requiresOwnerApproval"],
      "properties": {
        "default": { "type": "string", "enum": ["disabled", "enabled"] },
        "requiresOwnerApproval": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "mcpPolicy": {
      "type": "object",
      "required": ["default", "requiresOwnerApproval"],
      "properties": {
        "default": { "type": "string", "enum": ["disabled", "enabled"] },
        "requiresOwnerApproval": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "autonomousBehaviourPolicy": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "type": "string", "enum": ["disabled", "enabled"] },
        "notes": { "type": "string", "description": "ECC is never an autonomous runner under ProjectOS." }
      }
    },
    "reviewEvidenceTargets": {
      "type": "object",
      "description": "Maps review category -> evidence pack section heading.",
      "additionalProperties": { "type": "string" }
    }
  }
}