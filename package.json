{
  "name": "projectos",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectOS — Universal Project Delivery OS (framework + validators + reporter + deploy guard + proof factory + drift detector + CI governance + multi-project dashboard).",
  "type": "commonjs",
  "scripts": {
    "validate": "node projectos/validators/validate-all.cjs",
    "validate:schemas": "node projectos/validators/validate-project-config.cjs && node projectos/validators/validate-phase-manifest.cjs && node projectos/validators/validate-evidence-pack.cjs",
    "validate:examples": "node projectos/validators/validate-examples.cjs",
    "validate:forbidden": "node projectos/validators/validate-forbidden-actions.cjs",
    "validate:secrets": "node projectos/validators/validate-no-secrets.cjs",
    "validate:reviews": "node projectos/validators/validate-review-agents.cjs",
    "validate:ecc": "node projectos/validators/validate-ecc-routing.cjs",
    "validate:reporter": "node projectos/validators/validate-report-request.cjs && node projectos/validators/validate-report-index.cjs && node projectos/validators/validate-report-output.cjs && node projectos/validators/validate-phase-reporter.cjs",
    "validate:deployguard": "node projectos/validators/validate-staging-deploy-request.cjs && node projectos/validators/validate-staging-deploy-guard.cjs && node projectos/validators/validate-staging-deploy-output.cjs",
    "validate:proof": "node projectos/validators/validate-proof-request.cjs && node projectos/validators/validate-proof-plan.cjs && node projectos/validators/validate-proof-output.cjs && node projectos/validators/validate-proof-factory.cjs",
    "validate:drift": "node projectos/validators/validate-drift-request.cjs && node projectos/validators/validate-drift-snapshot.cjs && node projectos/validators/validate-drift-output.cjs && node projectos/validators/validate-drift-detector.cjs",
    "validate:ci": "node projectos/validators/validate-ci-governance-policy.cjs && node projectos/validators/validate-ci-workflow-template.cjs && node projectos/validators/validate-ci-output.cjs && node projectos/validators/validate-ci-governance.cjs",
    "validate:dashboard": "node projectos/validators/validate-dashboard-config.cjs && node projectos/validators/validate-dashboard-data.cjs && node projectos/validators/validate-dashboard-output.cjs && node projectos/validators/validate-dashboard-safety.cjs && node projectos/validators/validate-dashboard.cjs",
    "report:create": "node projectos/scripts/create-phase-report.cjs",
    "report:prepush": "node projectos/scripts/create-pre-push-review-pack.cjs",
    "report:closure": "node projectos/scripts/create-closure-report.cjs",
    "report:index": "node projectos/scripts/update-reports-index.cjs",
    "report:status": "node projectos/scripts/check-report-status.cjs",
    "report:check": "node projectos/scripts/create-report-skeleton.cjs --check",
    "deployguard:check": "node projectos/scripts/check-staging-deploy-request.cjs",
    "deployguard:plan": "node projectos/scripts/create-staging-deploy-plan.cjs",
    "deployguard:target": "node projectos/scripts/check-deploy-target.cjs",
    "deployguard:result": "node projectos/scripts/create-staging-deploy-result-skeleton.cjs",
    "proof:check": "node projectos/scripts/check-proof-request.cjs",
    "proof:plan": "node projectos/scripts/create-proof-plan.cjs",
    "proof:evidence": "node projectos/scripts/create-proof-evidence-skeleton.cjs",
    "proof:cleanup": "node projectos/scripts/create-cleanup-plan.cjs",
    "proof:target": "node projectos/scripts/check-proof-target.cjs",
    "drift:check": "node projectos/scripts/check-drift-request.cjs",
    "drift:snapshot": "node projectos/scripts/check-drift-snapshot.cjs",
    "drift:compare": "node projectos/scripts/compare-drift-snapshots.cjs",
    "drift:report": "node projectos/scripts/create-drift-report-skeleton.cjs",
    "drift:target": "node projectos/scripts/check-drift-target.cjs",
    "ci:policy": "node projectos/scripts/check-ci-governance-policy.cjs",
    "ci:workflow": "node projectos/scripts/check-ci-workflow-template.cjs",
    "ci:report": "node projectos/scripts/create-ci-governance-report.cjs",
    "ci:result": "node projectos/scripts/check-ci-result.cjs",
    "ci:target": "node projectos/scripts/check-ci-target.cjs",
    "dashboard:collect": "node projectos/scripts/collect-dashboard-data.cjs",
    "dashboard:build": "node projectos/scripts/build-static-dashboard.cjs",
    "dashboard:check": "node projectos/scripts/check-dashboard-data.cjs",
    "dashboard:safety": "node projectos/scripts/check-dashboard-safety.cjs",
    "dashboard:report": "node projectos/scripts/create-dashboard-report.cjs",
    "summary": "node projectos/scripts/print-framework-summary.cjs",
    "list": "node projectos/scripts/list-projectos-files.cjs"
  },
  "license": "UNLICENSED"
}